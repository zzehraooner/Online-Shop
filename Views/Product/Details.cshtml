@model OnlineShop.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb" style="font-size: 0.9rem;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color: var(--text-muted);">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" style="color: var(--text-muted);">Ürünler</a></li>
                <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.CategoryId" style="color: var(--text-muted);">@Model.Category?.Name</a></li>
                <li class="breadcrumb-item active" style="color: var(--text-primary);">@Model.Name</li>
            </ol>
        </nav>

        <div class="row g-5">
            <div class="col-lg-6 animate-fade-in">
                <div class="product-detail-image">
                    <img src="@(Model.ImageUrl ?? "https://placehold.co/600x600/1a1a2e/6c5ce7?text=Ürün")" alt="@Model.Name" />
                </div>
            </div>
            <div class="col-lg-6 animate-fade-in animate-delay-1">
                <div class="product-detail-info">
                    <span class="product-category" style="font-size: 0.85rem; margin-bottom: 0.75rem; display: inline-block;">@Model.Category?.Name</span>
                    <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 1rem;">@Model.Name</h1>
                    <div class="product-detail-price mb-3">₺@Model.Price.ToString("N2")</div>

                    <div class="mb-4" style="color: var(--text-secondary); line-height: 1.8;">
                        @Model.Description
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-4" style="font-size: 0.9rem;">
                        <div class="d-flex align-items-center gap-2">
                            @if (Model.Stock > 0)
                            {
                                <i class="bi bi-check-circle-fill" style="color: var(--success);"></i>
                                <span style="color: var(--success);">Stokta (@Model.Stock adet)</span>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill" style="color: var(--danger);"></i>
                                <span style="color: var(--danger);">Tükendi</span>
                            }
                        </div>
                        <span style="color: var(--dark-border);">|</span>
                        <div class="d-flex align-items-center gap-1" style="color: var(--text-muted);">
                            <i class="bi bi-truck"></i> Ücretsiz Kargo
                        </div>
                    </div>

                    @if (Model.Stock > 0)
                    {
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex gap-3">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="quantity-control">
                                <button type="button" onclick="decrementQty()">−</button>
                                <span id="qty-display">1</span>
                                <button type="button" onclick="incrementQty()">+</button>
                                <input type="hidden" name="quantity" id="qty-input" value="1" />
                            </div>
                            <button type="submit" class="btn-primary-custom flex-grow-1">
                                <i class="bi bi-cart-plus"></i>Sepete Ekle
                            </button>
                        </form>
                    }

                    <div class="row mt-4 pt-4" style="border-top: 1px solid var(--dark-border);">
                        <div class="col-4 text-center">
                            <i class="bi bi-shield-check" style="font-size: 1.5rem; color: var(--primary-light);"></i>
                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.3rem;">Güvenli Ödeme</div>
                        </div>
                        <div class="col-4 text-center">
                            <i class="bi bi-arrow-repeat" style="font-size: 1.5rem; color: var(--secondary);"></i>
                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.3rem;">Kolay İade</div>
                        </div>
                        <div class="col-4 text-center">
                            <i class="bi bi-headset" style="font-size: 1.5rem; color: var(--accent);"></i>
                            <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.3rem;">7/24 Destek</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        @if (ViewBag.RelatedProducts is IEnumerable<OnlineShop.Models.Product> related && related.Any())
        {
            <div class="mt-5 pt-4" style="border-top: 1px solid var(--dark-border);">
                <h2 class="section-title mb-4">Benzer Ürünler</h2>
                <div class="row g-4">
                    @foreach (var product in related)
                    {
                        <div class="col-lg-3 col-md-4 col-6">
                            <div class="product-card">
                                <div class="product-image">
                                    <img src="@(product.ImageUrl ?? "https://placehold.co/400x400/1a1a2e/6c5ce7?text=Ürün")" alt="@product.Name" loading="lazy" />
                                    <div class="product-overlay">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn-primary-custom btn-sm-custom">
                                            <i class="bi bi-eye"></i>Detay
                                        </a>
                                    </div>
                                </div>
                                <div class="product-info">
                                    <span class="product-category">@product.Category?.Name</span>
                                    <h3 class="product-name">@product.Name</h3>
                                    <span class="product-price">₺@product.Price.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
<script>
    let qty = 1;
    function incrementQty() {
        if (qty < @Model.Stock) { qty++; update(); }
    }
    function decrementQty() {
        if (qty > 1) { qty--; update(); }
    }
    function update() {
        document.getElementById('qty-display').textContent = qty;
        document.getElementById('qty-input').value = qty;
    }
</script>
}
