@model OnlineShop.Models.Product
@{
    ViewData["Title"] = "Ürün Düzenle";
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="section-title mb-4"><i class="bi bi-pencil me-2"></i>Ürün Düzenle</h1>
                <div class="checkout-section">
                    <form asp-action="EditProduct" method="post" class="form-custom">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" placeholder="Ürün adını girin" />
                                <span asp-validation-for="Name" class="text-danger" style="font-size: 0.8rem;"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Ürün açıklaması..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label"></label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" />
                                <span asp-validation-for="Price" class="text-danger" style="font-size: 0.8rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Stock" class="form-label"></label>
                                <input asp-for="Stock" class="form-control" type="number" placeholder="0" />
                                <span asp-validation-for="Stock" class="text-danger" style="font-size: 0.8rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label"></label>
                                <select asp-for="CategoryId" asp-items="@(ViewBag.Categories as SelectList)" class="form-select">
                                    <option value="">Kategori seçin</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger" style="font-size: 0.8rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ImageUrl" class="form-label"></label>
                                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mt-3">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label">Aktif</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mt-3">
                                    <input asp-for="IsFeatured" class="form-check-input" />
                                    <label asp-for="IsFeatured" class="form-check-label">Öne Çıkan</label>
                                </div>
                            </div>
                            <div class="col-12 mt-4">
                                <div class="d-flex gap-3">
                                    <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i>Kaydet</button>
                                    <a asp-action="Products" class="btn-secondary-custom"><i class="bi bi-x-lg"></i>İptal</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
