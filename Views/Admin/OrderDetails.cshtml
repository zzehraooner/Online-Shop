@model OnlineShop.Models.Order
@{
    ViewData["Title"] = "Sipariş Detayı - Admin";
    var sc = Model.Status switch
    {
        OnlineShop.Models.OrderStatus.Pending => "status-pending",
        OnlineShop.Models.OrderStatus.Confirmed => "status-confirmed",
        OnlineShop.Models.OrderStatus.Shipped => "status-shipped",
        OnlineShop.Models.OrderStatus.Delivered => "status-delivered",
        _ => "status-cancelled"
    };
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Orders" style="color: var(--text-muted);"><i class="bi bi-arrow-left fs-5"></i></a>
            <h1 class="section-title mb-0">Sipariş: @Model.OrderNumber</h1>
            <span class="status-badge @sc">@Model.Status</span>
        </div>
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="checkout-section">
                    <h4><i class="bi bi-person me-2" style="color: var(--primary);"></i>Müşteri Bilgileri</h4>
                    <div class="d-flex justify-content-between mb-2"><span style="color: var(--text-muted);">Ad Soyad</span><span>@Model.FullName</span></div>
                    <div class="d-flex justify-content-between mb-2"><span style="color: var(--text-muted);">Telefon</span><span>@Model.Phone</span></div>
                    <div class="d-flex justify-content-between mb-2"><span style="color: var(--text-muted);">Adres</span><span style="text-align: right; max-width: 300px;">@Model.ShippingAddress</span></div>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="d-flex justify-content-between"><span style="color: var(--text-muted);">Not</span><span style="text-align: right; max-width: 300px;">@Model.Note</span></div>
                    }
                </div>
                <div class="checkout-section">
                    <h4><i class="bi bi-box me-2" style="color: var(--secondary);"></i>Ürünler</h4>
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>@item.ProductName <span style="color: var(--text-muted);">x@item.Quantity</span></span>
                            <span style="font-weight: 600;">₺@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                        </div>
                    }
                    <hr style="border-color: var(--dark-border);" />
                    <div class="d-flex justify-content-between">
                        <span style="font-weight: 700;">Toplam</span>
                        <span style="font-weight: 800; font-size: 1.2rem; color: var(--primary-light);">₺@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="cart-summary">
                    <h4 style="font-weight: 600; margin-bottom: 1.5rem;">Durum Güncelle</h4>
                    <form asp-action="UpdateOrderStatus" method="post" class="form-custom">
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <select name="status" class="form-select mb-3">
                            @foreach (OnlineShop.Models.OrderStatus status in Enum.GetValues(typeof(OnlineShop.Models.OrderStatus)))
                            {
                                if (Model.Status == status)
                                {
                                    <option value="@((int)status)" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@((int)status)">@status</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn-primary-custom w-100 justify-content-center">
                            <i class="bi bi-check-lg"></i>Güncelle
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
