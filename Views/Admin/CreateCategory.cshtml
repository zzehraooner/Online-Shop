@model OnlineShop.Models.Category
@{
    ViewData["Title"] = "Yeni Kategori";
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <h1 class="section-title mb-4"><i class="bi bi-plus-circle me-2"></i>Yeni Kategori</h1>
                <div class="checkout-section">
                    <form asp-action="CreateCategory" method="post" class="form-custom">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Kategori adı" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Kategori açıklaması..."></textarea>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ImageUrl" class="form-label"></label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                        </div>
                        <div class="d-flex gap-3">
                            <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i>Kaydet</button>
                            <a asp-action="Categories" class="btn-secondary-custom"><i class="bi bi-x-lg"></i>İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
