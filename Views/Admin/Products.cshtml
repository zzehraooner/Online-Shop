@model IEnumerable<OnlineShop.Models.Product>
@{
    ViewData["Title"] = "Ürün Yönetimi";
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="section-title mb-0"><i class="bi bi-box me-2"></i>Ürün Yönetimi</h1>
            <a asp-action="CreateProduct" class="btn-primary-custom"><i class="bi bi-plus-lg"></i>Yeni Ürün</a>
        </div>
        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>Görsel</th>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th>Fiyat</th>
                        <th>Stok</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td><img src="@(product.ImageUrl ?? "https://placehold.co/40x40/1a1a2e/6c5ce7?text=P")" alt="" style="width: 40px; height: 40px; border-radius: 8px; object-fit: cover;" /></td>
                            <td style="font-weight: 600;">@product.Name</td>
                            <td style="color: var(--text-muted);">@product.Category?.Name</td>
                            <td style="color: var(--primary-light); font-weight: 600;">₺@product.Price.ToString("N2")</td>
                            <td>
                                @if (product.Stock < 10)
                                {
                                    <span style="color: var(--danger); font-weight: 600;">@product.Stock</span>
                                }
                                else
                                {
                                    <span>@product.Stock</span>
                                }
                            </td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="status-badge status-delivered">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-badge status-cancelled">Pasif</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn-secondary-custom btn-sm-custom" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Bu ürünü silmek istediğinizden emin misiniz?');">
                                        <button type="submit" class="btn-accent" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
