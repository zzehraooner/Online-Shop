@model IEnumerable<OnlineShop.Models.Order>
@{
    ViewData["Title"] = "Siparişlerim";
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <h1 class="section-title mb-4"><i class="bi bi-clock-history me-2"></i>Siparişlerim</h1>

        @if (Model.Any())
        {
            @foreach (var order in Model)
            {
                var statusClass = order.Status switch
                {
                    OnlineShop.Models.OrderStatus.Pending => "status-pending",
                    OnlineShop.Models.OrderStatus.Confirmed => "status-confirmed",
                    OnlineShop.Models.OrderStatus.Shipped => "status-shipped",
                    OnlineShop.Models.OrderStatus.Delivered => "status-delivered",
                    OnlineShop.Models.OrderStatus.Cancelled => "status-cancelled",
                    _ => "status-pending"
                };
                var statusText = order.Status switch
                {
                    OnlineShop.Models.OrderStatus.Pending => "Beklemede",
                    OnlineShop.Models.OrderStatus.Confirmed => "Onaylandı",
                    OnlineShop.Models.OrderStatus.Shipped => "Kargoda",
                    OnlineShop.Models.OrderStatus.Delivered => "Teslim Edildi",
                    OnlineShop.Models.OrderStatus.Cancelled => "İptal Edildi",
                    _ => "Beklemede"
                };
                <div class="order-card animate-fade-in">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <div style="font-weight: 700;">@order.OrderNumber</div>
                            <div style="font-size: 0.85rem; color: var(--text-muted);">@order.OrderDate.ToString("dd MMMM yyyy HH:mm")</div>
                        </div>
                        <span class="status-badge @statusClass">@statusText</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div style="font-size: 0.9rem; color: var(--text-secondary);">
                            @order.OrderItems.Count ürün
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span style="font-weight: 700; font-size: 1.1rem; color: var(--primary-light);">₺@order.TotalAmount.ToString("N2")</span>
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn-secondary-custom btn-sm-custom">
                                <i class="bi bi-eye"></i>Detay
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <h3>Henüz siparişiniz yok</h3>
                <p>Hemen alışverişe başlayın!</p>
                <a asp-controller="Product" asp-action="Index" class="btn-primary-custom">
                    <i class="bi bi-grid"></i>Ürünleri Keşfet
                </a>
            </div>
        }
    </div>
</section>
