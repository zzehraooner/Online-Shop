@model OnlineShop.Models.Order
@{
    ViewData["Title"] = "Sipariş Onayı";
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="text-center mb-5 animate-fade-in">
                    <div style="font-size: 5rem; margin-bottom: 1rem;">🎉</div>
                    <h1 class="section-title" style="color: var(--success);">Siparişiniz Alındı!</h1>
                    <p style="color: var(--text-secondary); font-size: 1.1rem;">Teşekkür ederiz. Siparişiniz başarıyla oluşturuldu.</p>
                </div>
                <div class="checkout-section animate-fade-in animate-delay-1">
                    <div class="d-flex justify-content-between mb-3">
                        <span style="color: var(--text-muted);">Sipariş No</span>
                        <span style="font-weight: 700; color: var(--primary-light);">@Model.OrderNumber</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span style="color: var(--text-muted);">Tarih</span>
                        <span>@Model.OrderDate.ToString("dd MMMM yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span style="color: var(--text-muted);">Durum</span>
                        <span class="status-badge status-pending">Beklemede</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span style="color: var(--text-muted);">Teslimat Adresi</span>
                        <span>@Model.ShippingAddress</span>
                    </div>
                    <hr style="border-color: var(--dark-border);" />
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex justify-content-between mb-2" style="font-size: 0.9rem;">
                            <span style="color: var(--text-secondary);">@item.ProductName x@item.Quantity</span>
                            <span>₺@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                        </div>
                    }
                    <hr style="border-color: var(--dark-border);" />
                    <div class="d-flex justify-content-between">
                        <span style="font-weight: 700; font-size: 1.2rem;">Toplam</span>
                        <span style="font-weight: 800; font-size: 1.3rem; color: var(--primary-light);">₺@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
                <div class="d-flex gap-3 justify-content-center mt-4 animate-fade-in animate-delay-2">
                    <a asp-controller="Order" asp-action="History" class="btn-secondary-custom">
                        <i class="bi bi-clock-history"></i>Siparişlerim
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="btn-primary-custom">
                        <i class="bi bi-grid"></i>Alışverişe Devam Et
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
