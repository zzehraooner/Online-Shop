@model OnlineShop.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Sipariş Tamamla";
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <h1 class="section-title mb-4"><i class="bi bi-credit-card me-2"></i>Sipariş Tamamla</h1>
        <form asp-controller="Order" asp-action="PlaceOrder" method="post" class="form-custom">
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="checkout-section animate-fade-in">
                        <h4><i class="bi bi-person me-2" style="color: var(--primary);"></i>Teslimat Bilgileri</h4>
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Adınız Soyadınız" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" placeholder="05XX XXX XX XX" />
                            <span asp-validation-for="Phone" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ShippingAddress" class="form-label"></label>
                            <textarea asp-for="ShippingAddress" class="form-control" rows="3" placeholder="Teslimat adresinizi girin..."></textarea>
                            <span asp-validation-for="ShippingAddress" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Note" class="form-label"></label>
                            <textarea asp-for="Note" class="form-control" rows="2" placeholder="Sipariş notunuz (opsiyonel)..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="cart-summary animate-fade-in animate-delay-1">
                        <h4 style="font-weight: 600; margin-bottom: 1.5rem;">Sipariş Özeti</h4>
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex justify-content-between mb-2" style="font-size: 0.9rem; color: var(--text-secondary);">
                                <span>@item.Product?.Name x@item.Quantity</span>
                                <span>₺@(((item.Product?.Price ?? 0) * item.Quantity).ToString("N2"))</span>
                            </div>
                        }
                        <hr style="border-color: var(--dark-border);" />
                        <div class="d-flex justify-content-between mb-2" style="color: var(--text-secondary);">
                            <span>Kargo</span>
                            <span style="color: var(--success);">Ücretsiz</span>
                        </div>
                        <hr style="border-color: var(--dark-border);" />
                        <div class="d-flex justify-content-between mb-4">
                            <span style="font-weight: 700; font-size: 1.1rem;">Toplam</span>
                            <span style="font-weight: 800; font-size: 1.3rem; color: var(--primary-light);">₺@Model.TotalPrice.ToString("N2")</span>
                        </div>
                        <button type="submit" class="btn-primary-custom w-100 justify-content-center">
                            <i class="bi bi-check-circle"></i>Siparişi Onayla
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
