@model OnlineShop.Models.Order
@{
    ViewData["Title"] = "Sipariş Detayı";
    var statusClass = Model.Status switch
    {
        OnlineShop.Models.OrderStatus.Pending => "status-pending",
        OnlineShop.Models.OrderStatus.Confirmed => "status-confirmed",
        OnlineShop.Models.OrderStatus.Shipped => "status-shipped",
        OnlineShop.Models.OrderStatus.Delivered => "status-delivered",
        OnlineShop.Models.OrderStatus.Cancelled => "status-cancelled",
        _ => "status-pending"
    };
    var statusText = Model.Status switch
    {
        OnlineShop.Models.OrderStatus.Pending => "Beklemede",
        OnlineShop.Models.OrderStatus.Confirmed => "Onaylandı",
        OnlineShop.Models.OrderStatus.Shipped => "Kargoda",
        OnlineShop.Models.OrderStatus.Delivered => "Teslim Edildi",
        OnlineShop.Models.OrderStatus.Cancelled => "İptal Edildi",
        _ => "Beklemede"
    };
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-controller="Order" asp-action="History" style="color: var(--text-muted);"><i class="bi bi-arrow-left fs-5"></i></a>
            <h1 class="section-title mb-0">Sipariş Detayı</h1>
        </div>
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="checkout-section">
                    <div class="d-flex justify-content-between mb-3">
                        <span style="color: var(--text-muted);">Sipariş No</span>
                        <span style="font-weight: 700; color: var(--primary-light);">@Model.OrderNumber</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span style="color: var(--text-muted);">Tarih</span>
                        <span>@Model.OrderDate.ToString("dd MMMM yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span style="color: var(--text-muted);">Durum</span>
                        <span class="status-badge @statusClass">@statusText</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span style="color: var(--text-muted);">Ad Soyad</span>
                        <span>@Model.FullName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span style="color: var(--text-muted);">Telefon</span>
                        <span>@Model.Phone</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span style="color: var(--text-muted);">Adres</span>
                        <span style="text-align: right; max-width: 300px;">@Model.ShippingAddress</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="cart-summary">
                    <h4 style="font-weight: 600; margin-bottom: 1.5rem;">Ürünler</h4>
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex justify-content-between mb-2" style="font-size: 0.9rem;">
                            <span style="color: var(--text-secondary);">@item.ProductName x@item.Quantity</span>
                            <span>₺@((item.UnitPrice * item.Quantity).ToString("N2"))</span>
                        </div>
                    }
                    <hr style="border-color: var(--dark-border);" />
                    <div class="d-flex justify-content-between">
                        <span style="font-weight: 700;">Toplam</span>
                        <span style="font-weight: 800; font-size: 1.2rem; color: var(--primary-light);">₺@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
