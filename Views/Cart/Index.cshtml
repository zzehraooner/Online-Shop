@model OnlineShop.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Sepetim";
}

<section class="section-padding" style="padding-top: 2rem;">
    <div class="container">
        <h1 class="section-title mb-4"><i class="bi bi-cart3 me-2"></i>Sepetim</h1>

        @if (Model.Items.Any())
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    @foreach (var item in Model.Items)
                    {
                        <div class="cart-item animate-fade-in">
                            <img src="@(item.Product?.ImageUrl ?? "https://placehold.co/80x80/1a1a2e/6c5ce7?text=Ürün")" alt="@item.Product?.Name" />
                            <div class="cart-item-info">
                                <div class="cart-item-name">@item.Product?.Name</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted);">@item.Product?.Category?.Name</div>
                                <div class="cart-item-price mt-1">₺@((item.Product?.Price ?? 0).ToString("N2"))</div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="quantity-control">
                                    <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" style="display: inline;">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                        <button type="submit">−</button>
                                    </form>
                                    <span>@item.Quantity</span>
                                    <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" style="display: inline;">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                        <button type="submit">+</button>
                                    </form>
                                </div>
                                <div style="min-width: 100px; text-align: right;">
                                    <div style="font-weight: 700; color: var(--primary-light);">₺@(((item.Product?.Price ?? 0) * item.Quantity).ToString("N2"))</div>
                                </div>
                                <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" style="background: none; border: none; color: var(--danger); cursor: pointer; font-size: 1.2rem;">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-lg-4">
                    <div class="cart-summary animate-fade-in animate-delay-2">
                        <h4 style="font-weight: 600; margin-bottom: 1.5rem;">Sipariş Özeti</h4>
                        <div class="d-flex justify-content-between mb-2" style="color: var(--text-secondary);">
                            <span>Ürünler (@Model.TotalItems adet)</span>
                            <span>₺@Model.TotalPrice.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2" style="color: var(--text-secondary);">
                            <span>Kargo</span>
                            <span style="color: var(--success);">Ücretsiz</span>
                        </div>
                        <hr style="border-color: var(--dark-border);" />
                        <div class="d-flex justify-content-between mb-4">
                            <span style="font-weight: 700; font-size: 1.1rem;">Toplam</span>
                            <span style="font-weight: 800; font-size: 1.3rem; color: var(--primary-light);">₺@Model.TotalPrice.ToString("N2")</span>
                        </div>
                        <a asp-controller="Order" asp-action="Checkout" class="btn-primary-custom w-100 justify-content-center">
                            <i class="bi bi-credit-card"></i>Siparişi Tamamla
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="btn-secondary-custom w-100 justify-content-center mt-3" style="font-size: 0.9rem;">
                            <i class="bi bi-arrow-left"></i>Alışverişe Devam Et
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">🛒</div>
                <h3>Sepetiniz boş</h3>
                <p>Hadi alışverişe başlayalım!</p>
                <a asp-controller="Product" asp-action="Index" class="btn-primary-custom">
                    <i class="bi bi-grid"></i>Ürünleri Keşfet
                </a>
            </div>
        }
    </div>
</section>
