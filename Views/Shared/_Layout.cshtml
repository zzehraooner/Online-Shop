@using System.Security.Claims
@using OnlineShop.Services
@inject IServiceProvider ServiceProvider
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineShop</title>
    <meta name="description" content="OnlineShop - Premium alışveriş deneyimi. En iyi ürünleri en iyi fiyatlarla keşfedin." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bag-heart-fill me-2"></i>OnlineShop
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="color: var(--text-primary);">
                <i class="bi bi-list fs-4"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i>Ana Sayfa
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-grid me-1"></i>Ürünler
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link cart-badge" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 fs-5"></i>
                                <span class="badge" id="cartCount">0</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" style="background: var(--dark-card); border-color: var(--dark-border);">
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="History" style="color: var(--text-secondary);"><i class="bi bi-clock-history me-2"></i>Siparişlerim</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider" style="border-color: var(--dark-border);"></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard" style="color: var(--secondary);"><i class="bi bi-speedometer2 me-2"></i>Admin Panel</a></li>
                                }
                                <li><hr class="dropdown-divider" style="border-color: var(--dark-border);"></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                        <button type="submit" class="dropdown-item" style="color: var(--danger);"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-primary-custom btn-sm-custom" asp-area="Identity" asp-page="/Account/Register">
                                Kayıt Ol
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main style="padding-top: 70px;">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert-custom alert-success-custom animate-fade-in">
                    <i class="bi bi-check-circle-fill" style="color: var(--success);"></i>
                    @TempData["Success"]
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert-custom alert-error-custom animate-fade-in">
                    <i class="bi bi-exclamation-circle-fill" style="color: var(--danger);"></i>
                    @TempData["Error"]
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <h5><i class="bi bi-bag-heart-fill me-2" style="color: var(--primary);"></i>OnlineShop</h5>
                    <p class="mb-3" style="font-size: 0.9rem;">Premium alışveriş deneyimi. En kaliteli ürünleri en iyi fiyatlarla keşfedin.</p>
                    <div class="d-flex gap-3">
                        <a href="#" style="font-size: 1.3rem;"><i class="bi bi-instagram"></i></a>
                        <a href="#" style="font-size: 1.3rem;"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" style="font-size: 1.3rem;"><i class="bi bi-facebook"></i></a>
                        <a href="#" style="font-size: 1.3rem;"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h5>Mağaza</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Product" asp-action="Index">Tüm Ürünler</a></li>
                        <li class="mb-2"><a href="#">Yeni Gelenler</a></li>
                        <li class="mb-2"><a href="#">Çok Satanlar</a></li>
                        <li class="mb-2"><a href="#">İndirimler</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h5>Destek</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#">Yardım Merkezi</a></li>
                        <li class="mb-2"><a href="#">Kargo Takibi</a></li>
                        <li class="mb-2"><a href="#">İade & Değişim</a></li>
                        <li class="mb-2"><a href="#">İletişim</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-4 mb-4">
                    <h5>Bülten</h5>
                    <p style="font-size: 0.9rem;">Kampanyalardan haberdar olmak için abone olun.</p>
                    <div class="d-flex gap-2 mt-3">
                        <input type="email" class="form-control" placeholder="E-posta adresiniz" style="background: var(--dark-card); border-color: var(--dark-border); color: var(--text-primary); border-radius: var(--radius-md);">
                        <button class="btn btn-primary-custom btn-sm-custom">Abone Ol</button>
                    </div>
                </div>
            </div>
            <div class="footer-bottom text-center">
                <p class="mb-0">&copy; @DateTime.Now.Year OnlineShop. Tüm hakları saklıdır.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
